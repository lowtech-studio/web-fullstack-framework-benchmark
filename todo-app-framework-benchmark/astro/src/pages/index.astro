---
import { getTodos, createTodo, deleteTodo } from '../db.js';

let todos = [];

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const todo = formData.get('todo');
  if (todo) {
    createTodo(todo);
    return Astro.redirect('/', 302);
  }
} else if (Astro.request.method === 'GET' && Astro.url.searchParams.has('delete')) {
  const todo = Astro.url.searchParams.get('delete');
  if (todo) {
    deleteTodo(todo);
    return Astro.redirect('/', 302);
  }
}

todos = getTodos();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToDo App</title>
</head>
<body>
  <h1>ToDo App Benchmark</h1>
  <form method="post">
    <input  id="create-todo-field" type="text" name="todo" required>
    <button id="create-todo-button" type="submit">Submit</button>
  </form>
  <ul>
    {todos.map((todo) => (
      <li>
        {todo.todo}
        <a id={`delete-todo-link-${todo.todo}`} href={`/?delete=${encodeURIComponent(todo.todo)}`}>Delete</a>
      </li>
    ))}
  </ul>
</body>
</html>
